```gitignore
# Dependencies
__pycache__/
*.pyc
*.pyo
*.pyd

# Environment variables
.env
.env.local
*.env.*

# Logs
*.log

# Coverage reports
.coverage
coverage/
htmlcov/

# Temporary files
*.tmp
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Build artifacts
build/
dist/
*.egg-info/

# Testing
.pytest_cache/
.mypy_cache/
.tox/

# Virtual environments
venv/
.venv/
env/
ENV/
```